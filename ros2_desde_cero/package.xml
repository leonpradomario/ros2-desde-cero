<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_desde_cero</name>
  <version>0.1.0</version>
  <description>Ejemplos mínimos de ROS2 en español: publicador/suscriptor, servicio y launch file.</description>
  <maintainer email="292083661+leonpradomario@users.noreply.github.com">Mario Leon Prado</maintainer>
  <license>MIT</license>

  <!-- Lo que el paquete necesita para ejecutarse. Todo viene con ROS2 Humble. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
